# ==============================================================================
# ENVIRONMENT VARIABLES - INVENTARIS KANTOR NARASUMBERHUKUM
# ==============================================================================

# Database SQLite (lokasi file database)
DATABASE_URL="file:./prisma/dev.db"

# Public Domain & Subpath
APP_URL="https://dashboard.narasumberhukum.com/inventaris-nh"
BASE_PATH="/inventaris-nh"
NEXT_PUBLIC_BASE_PATH="/inventaris-nh"

# Session Secret (Ganti dengan string acak panjang untuk produksi)
SESSION_SECRET="office-inventory-super-secure-random-secret-key-2026"

# Cookie Security (Gunakan "true" jika menggunakan domain HTTPS)
COOKIE_SECURE="true"

# Server Port & Host Binding
PORT=3000
HOST="0.0.0.0"
